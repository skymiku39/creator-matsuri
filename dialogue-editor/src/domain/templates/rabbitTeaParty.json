        "note": "此為超連結"
      }
    },
    {
      "id": "choice_40",
      "type": "choice",
      "position": {
        "x": 1540,
        "y": 40
      },
      "data": {
        "kind": "choice",
        "title": "選項E",
        "text": "等一下再過來",
        "note": "",
        "isReturn": true
      }
    },
    {
      "id": "msg_42",
      "type": "message",
      "position": {
        "x": 1540,
        "y": 150
      },
      "data": {
        "kind": "message",
        "title": "選項E內容01",
        "text": "「好的，等等見。」 ",
        "note": ""
      }
