  "nodes": [
    {
      "id": "msg_1",
      "type": "message",
      "position": {
        "x": 80,
        "y": 40
      },
      "data": {
        "kind": "message",
        "title": "01攤位對話01",
        "text": "「你好啊~ 這裡是《兔子茶會 RabbitTeaParty》的官方攤位喔！」",
        "note": ""
      }
    },
    {
      "id": "msg_2",
      "type": "message",
      "position": {
        "x": 80,
        "y": 150
      },
      "data": {
        "kind": "message",
        "title": "01攤位對話02",
        "text": "「那麼關於本次活動你想問什麼呢？」",
        "note": ""
      }
    },
    {
      "id": "menu_4",
      "type": "choiceMenu",
      "position": {
        "x": 80,
        "y": 260
      },
      "data": {
        "kind": "choiceMenu",
        "title": "對話選項",
        "text": "",
        "note": "每個選項分支建議包含返回選單的選項"
      }
    },
    {
      "id": "choice_6",
      "type": "choice",
      "position": {
        "x": 420,
        "y": 40
      },
      "data": {
        "kind": "choice",
        "title": "選項A",
        "text": "再次辦活動的原因",
        "note": "一共有5個對話選項，可以依照創作的性質自訂，\n但每個對話選項之中必須包含返回的選項。",
        "isReturn": false
      }
    },
    {
      "id": "msg_8",
      "type": "message",
      "position": {
        "x": 420,
        "y": 150
      },
      "data": {
        "kind": "message",
        "title": "選項A內容01",
        "text": "「關於這點..原先只是想找人接手我這個線上活動的..」",
        "note": ""
      }
    },
    {
      "id": "msg_10",
      "type": "message",
      "position": {
        "x": 420,
        "y": 260
      },
      "data": {
        "kind": "message",
        "title": "選項A內容02",
        "text": "「不知不覺就變成再次舉辦線上活動。」",
        "note": ""
      }
    },
    {
      "id": "msg_12",
      "type": "message",
      "position": {
        "x": 420,
        "y": 370
      },
      "data": {
        "kind": "message",
        "title": "選項A內容03",
        "text": "「這次活動我會使用 RPG Maker MZ 作為線上擺攤的會場。」",
        "note": ""
      }
    },
    {
      "id": "msg_14",
      "type": "message",
      "position": {
        "x": 420,
        "y": 480
      },
      "data": {
        "kind": "message",
        "title": "選項A內容04",
        "text": "「如果有興趣的話可以前往關注下我們活動的相關資訊喔~」",
        "note": ""
      }
    },
    {
      "id": "url_16",
      "type": "url",
      "position": {
        "x": 420,
        "y": 590
      },
      "data": {
        "kind": "url",
        "title": "選項A連結",
        "text": "https://rabbitteaparty.blogspot.com/2021/12/RabbitTeaParty01.html",
        "note": "此為超連結"
      }
    },
    {
      "id": "choice_18",
      "type": "choice",
      "position": {
        "x": 700,
        "y": 40
      },
      "data": {
        "kind": "choice",
        "title": "選項B",
        "text": "未來還會再舉辦嗎？",
        "note": "",
        "isReturn": false
      }
    },
    {
      "id": "msg_20",
      "type": "message",
      "position": {
        "x": 700,
        "y": 150
      },
      "data": {
        "kind": "message",
        "title": "選項B內容01",
        "text": "「先不要..光是將近六個月的籌備就夠我們忙了。」",
        "note": ""
      }
    },
    {
      "id": "msg_22",
      "type": "message",
      "position": {
        "x": 700,
        "y": 260
      },
      "data": {
        "kind": "message",
        "title": "選項B內容02",
        "text": "「不過..我們會考慮看看再次舉辦的可能性。」",
        "note": ""
      }
    },
    {
      "id": "choice_24",
      "type": "choice",
      "position": {
        "x": 980,
        "y": 40
      },
      "data": {
        "kind": "choice",
        "title": "選項C",
        "text": "這裡是哪裡？",
        "note": "",
        "isReturn": false
      }
    },
    {
      "id": "msg_26",
      "type": "message",
      "position": {
        "x": 980,
        "y": 150
      },
      "data": {
        "kind": "message",
        "title": "選項C內容01",
        "text": "「你說這裡是哪裡？」 ",
        "note": "頭上要顯示「問號」氣泡"
      }
    },
    {
      "id": "msg_28",
      "type": "message",
      "position": {
        "x": 980,
        "y": 260
      },
      "data": {
        "kind": "message",
        "title": "選項C內容02",
        "text": "「其實這個會場是向Vtuber社團『MIX米克斯學園』借來的學校場地。」 ",
        "note": ""
      }
    },
    {
      "id": "msg_30",
      "type": "message",
      "position": {
        "x": 980,
        "y": 370
      },
      "data": {
        "kind": "message",
        "title": "選項C內容03",
        "text": "「如果有興趣的話，可以前往關注下她們的Twitter(X)喔~」",
        "note": ""
      }
    },
    {
      "id": "url_32",
      "type": "url",
      "position": {
        "x": 980,
        "y": 480
      },
      "data": {
        "kind": "url",
        "title": "選項C連結",
        "text": "https://x.com/MixMimimix",
        "note": "此為超連結"
      }
    },
    {
      "id": "choice_34",
      "type": "choice",
      "position": {
        "x": 1260,
        "y": 40
      },
      "data": {
        "kind": "choice",
        "title": "選項D",
        "text": "追隨Twitter(X)",
        "note": "",
        "isReturn": false
      }
    },
    {
      "id": "msg_36",
      "type": "message",
      "position": {
        "x": 1260,
        "y": 150
      },
      "data": {
        "kind": "message",
        "title": "選項D內容01",
        "text": "「可以喔！如果有新的消息我們也都會發文在這邊的。」 ",
        "note": ""
      }
    },
    {
      "id": "url_38",
      "type": "url",
